# ============================================================
# Smart Assistant - environment variables
# 1. Copy this file:   copy .env.example .env
# 2. Paste your real keys into .env  (never share or commit .env!)
# Step-by-step instructions for every key: docs/01_setup.md
#
# Every agent is optional EXCEPT the LLM key. A missing key just turns
# that agent "❌ off" in the startup banner.
# ============================================================

# ---------- 🧠 LLM (required) ----------
# Free Google Gemini key -> https://aistudio.google.com/apikey
# One key gives BOTH the chat model and the embedding model (used by RAG).
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: Groq instead of Gemini for chat -> https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ---------- 📚 RAG agent: Pinecone hosted vector database ----------
# Free Starter plan -> https://app.pinecone.io  (API Keys page)
PINECONE_API_KEY=your_pinecone_api_key_here
# The index is created automatically on first run (768 dimensions, cosine, aws us-east-1)
PINECONE_INDEX_NAME=smart-assistant-pdfs

# ---------- 🐙 GitHub agent ----------
# Fine-grained Personal Access Token -> https://github.com/settings/personal-access-tokens
# Read-only permissions are enough (the agent runs in read-only mode).
GITHUB_TOKEN=your_github_token_here

# ---------- 📅 Calendar + 📧 Gmail agents ----------
# OAuth "Desktop app" client from Google Cloud Console (Calendar API + Gmail API enabled)
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
# The Google account whose calendar and mailbox the agents use
USER_GOOGLE_EMAIL=your_email_here@gmail.com
# Optional: your name, used to sign emails
USER_NAME=
